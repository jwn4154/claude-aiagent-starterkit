# 환경변수 (API 키 등 비밀값)
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# SqliteSaver 체크포인터 (CHECKPOINTER_BACKEND=sqlite일 때 생성됨)
checkpoints.db

# 샌드박스 작업 디렉터리 — file_tools 도구가 읽는 파일이 쌓이는 곳
workspace/*
!workspace/.gitkeep

# IDE
.vscode/
.idea/

# Claude Code 로컬 전용 설정 (권한 승인 상태 등) — .claude/commands/는 공유 대상이라 여기 포함 안 함
.claude/settings.local.json

# Playwright MCP 테스트 산출물
.playwright-mcp/

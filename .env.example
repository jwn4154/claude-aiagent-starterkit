# OpenAI API 키 (필수) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 사용할 모델 (선택, 기본값 gpt-4o)
OPENAI_MODEL=gpt-4o

# Tavily 웹 검색 API 키 (선택) — 없으면 web_search 도구가 안내 메시지만 반환합니다
# https://tavily.com
TAVILY_API_KEY=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=여기에_키
LANGCHAIN_PROJECT=claude-aiagent-starterkit